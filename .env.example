# Copy to .env and fill in. NEVER commit .env.
# Data source URLs
RAVDESS_URL=https://zenodo.org/record/1188976/files/Audio_Speech_Actors_01-24.zip
CREMA_URL=
TESS_URL=

# External services (off-the-shelf glue — see glue/)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional automatic fallback; leave blank to use OpenAI only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE_ID=

# Reproducibility
SEED=42
LOG_LEVEL=INFO

# Shared audio/feature contract (keep identical for preparation, training, and serving)
SAMPLE_RATE=16000
FRAME_MS=25
STRIDE_MS=10
N_MFCC=20
F0_FRAME_MS=50
F0_MIN_HZ=50
F0_MAX_HZ=500

# Inference tuning
INFERENCE_WINDOW_MS=2000
INFERENCE_LATENCY_BUDGET_MS=300
